{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CanonKeeper",
  "mainBinaryName": "canonkeeper",
  "identifier": "ru.canonkeeper.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "publisher": "CanonKeeper",
    "homepage": "https://canonkeeper.ru",
    "category": "Productivity",
    "shortDescription": "Книги саги и помощник писателя на вашем компьютере",
    "longDescription": "CanonKeeper держит книги автора на его компьютере: чтение, поиск, заметки и вопросы помощнику по тексту саги. Ядро открыто.",
    "license": "AGPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "linux": {
      "deb": { "section": "text" },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NUMxREVCMUI0ODQzMkMKUldRc1EwZ2I2eDFjTllJb2FLTTRCT3UwZHNtMkFxODlJTTNzTDFQTXVQUlhTZi84ek16Z1lHWS8K",
      "endpoints": ["https://canonkeeper.ru/app/open/latest.json", "https://github.com/canonkeeper/desktop-app/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
