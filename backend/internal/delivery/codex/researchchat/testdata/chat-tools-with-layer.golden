[
 {
  "name": "saga.search",
  "description": "Поиск по абзацам саги. Возвращает общее число совпадений, распределение по главам (все главы с совпадениями по порядку книги) и сами совпадения со сниппетами. Учитывает словоформы; ударения и «ё» не мешают. Можно передать несколько запросов сразу (синонимы, варианты имён).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "queries": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "description": "Запросы. В режиме any слова объединяются через ИЛИ; фразу можно взять в кавычки; слово* ищет по началу слова."
    },
    "match": {
     "type": "string",
     "enum": [
      "any",
      "all",
      "phrase",
      "substring"
     ],
     "description": "any (по умолчанию): хотя бы одно слово, выше — абзацы, где совпало больше слов; all: все слова в одном абзаце; phrase: слова подряд; substring: часть слова или точная строка (например «контроллер» найдёт «миниконтроллер»)."
    },
    "order": {
     "type": "string",
     "enum": [
      "relevance",
      "story"
     ],
     "description": "relevance (по умолчанию) или story — по порядку книги, от ранних глав к поздним."
    },
    "from": {
     "type": "string",
     "description": "Первая глава диапазона, например \"530\"."
    },
    "to": {
     "type": "string",
     "description": "Последняя глава диапазона, например \"617\"."
    },
    "books": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "description": "Ограничить томами."
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 150,
     "description": "Сколько совпадений показать на запрос (по умолчанию 30)."
    },
    "offset": {
     "type": "integer",
     "minimum": 0,
     "description": "Сдвиг для следующей страницы совпадений."
    }
   },
   "required": [
    "queries"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "saga.read",
  "description": "Прочитать главу целиком или её часть. Абзацы пронумерованы (¶). Для контекста вокруг найденного абзаца используйте around и radius.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "chapter": {
     "type": "string",
     "description": "Ключ главы: сквозной номер, например \"481\", или ключ из результатов search/chapters."
    },
    "from": {
     "type": "integer",
     "minimum": 1,
     "description": "Первый абзац."
    },
    "to": {
     "type": "integer",
     "minimum": 1,
     "description": "Последний абзац."
    },
    "around": {
     "type": "integer",
     "minimum": 1,
     "description": "Абзац, вокруг которого читать."
    },
    "radius": {
     "type": "integer",
     "minimum": 0,
     "maximum": 40,
     "description": "Сколько абзацев до и после around (по умолчанию 4)."
    }
   },
   "required": [
    "chapter"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "saga.chapters",
  "description": "Список глав саги по порядку: ключ, том, название, число абзацев. detail=summary добавляет подробный пересказ главы; detail=card — пересказ, указания на время (сколько прошло, даты, сроки) и изменения состояний. Пересказы построены моделью и служат навигацией; факты проверяйте в тексте через read.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "from": {
     "type": "string",
     "description": "Первая глава диапазона."
    },
    "to": {
     "type": "string",
     "description": "Последняя глава диапазона."
    },
    "books": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "description": "Ограничить томами."
    },
    "title": {
     "type": "string",
     "description": "Подстрока названия главы."
    },
    "detail": {
     "type": "string",
     "enum": [
      "titles",
      "summary",
      "card"
     ],
     "description": "titles (по умолчанию), summary или card."
    }
   },
   "additionalProperties": false
  }
 },
 {
  "name": "saga.glossary",
  "description": "Словарь саги, собранный из всех глав: персонажи и сущности (места, организации, семьи, народы, предметы, события, понятия и роды вещей, свойственные самой книге) — с синонимами, кратким описанием и списком глав, где они встречаются. Без аргументов показывает типы и их количество. Для перечислений («все города», «все организации») выбирайте types; для конкретного имени — query.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "query": {
     "type": "string",
     "description": "Подстрока имени, синонима или описания."
    },
    "types": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "type": "string"
     },
     "description": "Типы из списка, который даёт вызов без аргументов, например [\"город\",\"место\"]."
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000,
     "description": "Сколько записей показать (по умолчанию 300)."
    }
   },
   "additionalProperties": false
  }
 },
 {
  "name": "saga.entity",
  "description": "Досье персонажа или сущности из фактов всех глав под всеми её именами: возраст, раса, класс, уровень, ранг, титул, должность, статус, местонахождение, здоровье — значение на конец диапазона и история смен; навыки, предметы, снаряжение, отношения, знания и прочие свойства — различные значения с главами. Отвечает одним вызовом на «сколько лет», «какой уровень к главе N», «что у него есть», «с кем в каких отношениях». at — значение на главу. Факты выписаны моделью по главам: важное проверяйте в тексте через read по ссылке.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "description": "Имя или синоним, как в glossary."
    },
    "at": {
     "type": "string",
     "description": "Глава, на которую нужны значения (включительно); по умолчанию — вся сага."
    },
    "attributes": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "type": "string"
     },
     "description": "Только эти свойства, с полной историей, например [\"возраст\",\"уровень\"]."
    }
   },
   "required": [
    "name"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "saga.timeline",
  "description": "Шкала времени сюжета: для каждой главы — день сюжета от начала саги (сумма промежутков между главами и длительностей глав из карточек), дата мира, фраза, с которой глава начинается во времени, и события главы с абзацами. from и to вместе дают, сколько прошло между главами. Неизвестные промежутки считаются нулём и названы счётчиком — это нижняя оценка. query отбирает события («турнир», «день рождения»); события показываются для диапазона до 40 глав или по query.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "from": {
     "type": "string",
     "description": "Первая глава диапазона."
    },
    "to": {
     "type": "string",
     "description": "Последняя глава диапазона."
    },
    "query": {
     "type": "string",
     "description": "Слова события, участника или времени."
    }
   },
   "additionalProperties": false
  }
 },
 {
  "name": "saga.threads",
  "description": "Сюжетные нити и арки саги: открытые вопросы и тайны, обещания, долги, конфликты, планы, подвешенные детали. Без level — реестр открытых нитей всей саги, важные первыми; level=all добавляет нити отдельных книг, не вошедшие в реестр, с пометкой «по книге, могло закрыться» (могли закрыться позже, проверяйте); part=arcs — арки по книгам. who находит нити героя под всеми его именами, query — по словам, kind — по виду (тайна, обещание, конфликт, план, задание, ружьё, отношения, долг). Ответ называет, по какую главу собран слой и сколько глав новее. Нить — навигация, а не факт: важное проверяйте в тексте через read по ссылке.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "query": {
     "type": "string",
     "maxLength": 300,
     "description": "Слова, которые есть в нити или арке."
    },
    "who": {
     "type": "string",
     "maxLength": 300,
     "description": "Имя героя или синоним, как в glossary."
    },
    "kind": {
     "type": "string",
     "maxLength": 300,
     "description": "Вид нити, например \"тайна\"."
    },
    "level": {
     "type": "string",
     "enum": [
      "all"
     ],
     "description": "all — вместе с нитями книг, не вошедшими в реестр: для поиска подвешенной детали."
    },
    "part": {
     "type": "string",
     "enum": [
      "arcs"
     ],
     "description": "arcs — арки по книгам вместо нитей."
    }
   },
   "additionalProperties": false
  }
 },
 {
  "name": "saga.changes",
  "description": "Хронология изменений по персонажу, предмету, месту или чему угодно: что и в какой главе менялось (положение, здоровье, отношения, знания и тайны, владение, статус и звание, способности, договорённости и сроки), по порядку книги. Имя из словаря находит изменения и под другими именами записи.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "subject": {
     "type": "string",
     "minLength": 1,
     "description": "Имя или ключевое слово."
    },
    "from": {
     "type": "string",
     "description": "Первая глава диапазона."
    },
    "to": {
     "type": "string",
     "description": "Последняя глава диапазона."
    }
   },
   "required": [
    "subject"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "saga.scan",
  "description": "Исчерпывающий просмотр текста: модель читает каждую главу диапазона (по умолчанию всю сагу) и выписывает все места, относящиеся к задаче, включая упоминания мимоходом и описания без ключевых слов. Один вызов за минуту просматривает часть саги и называет главу, с которой продолжить (from) с тем же task. Тоже может пропускать места. Используйте для «найди все…», для смысловых поисков и когда search не даёт уверенности.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "task": {
     "type": "string",
     "minLength": 3,
     "maxLength": 500,
     "description": "Что искать, своими словами, например «все места, где герой упоминает отца»."
    },
    "from": {
     "type": "string",
     "description": "Первая глава диапазона."
    },
    "to": {
     "type": "string",
     "description": "Последняя глава диапазона."
    },
    "books": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "description": "Ограничить томами."
    }
   },
   "required": [
    "task"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "saga.remember",
  "description": "Сохранить в память автора то, что автор сказал или одобрил и чего нет в тексте саги. Только его слова, не ваши выводы и не догадки. Действие видно автору в ленте («Запомнил: …», там его можно отменить), запись он правит на карте саги, «Что помнит помощник». Записывать может редактор проекта.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "plan",
      "correction",
      "style_rule",
      "rejected"
     ],
     "description": "plan — что автор задумал, в книге этого ещё нет; correction — поправка автора к фактам; style_rule — правило стиля; rejected — что автор отверг."
    },
    "text": {
     "type": "string",
     "minLength": 1,
     "maxLength": 8000,
     "description": "Что сказал автор, близко к его словам."
    },
    "chapter": {
     "type": "string",
     "description": "Ключ главы, если запись о конкретной главе."
    },
    "name": {
     "type": "string",
     "maxLength": 200,
     "description": "Имя героя или название, если запись о нём."
    }
   },
   "required": [
    "kind",
    "text"
   ],
   "additionalProperties": false
  }
 },
 {
  "name": "saga.memory",
  "description": "Прочитать память автора по этой саге: планы, поправки, правила стиля и отвергнутое, новые первыми, каждая запись подписана видом. Читайте перед тем, как писать или планировать главу. Планы — не события книги.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "query": {
     "type": "string",
     "maxLength": 200,
     "description": "Подстрока текста записи или имени."
    },
    "kind": {
     "type": "string",
     "enum": [
      "plan",
      "correction",
      "style_rule",
      "rejected"
     ],
     "description": "Только записи этого вида."
    }
   },
   "additionalProperties": false
  }
 },
 {
  "name": "saga.attachment",
  "description": "Прочитать главу автора, приложенную к вопросу этого чата: текст автора, в книге его ещё нет; текст книги важнее. Абзацы пронумерованы (¶), ссылка на место — [прил. ¶N](attachment:\u003cномер\u003e/N). За вызов — до 6 000 слов; длинную главу читайте дальше с from, который называет ответ.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "attachment": {
     "type": "integer",
     "minimum": 1,
     "maximum": 999,
     "description": "Номер приложения в этом чате (из шапки вопроса); по умолчанию — последнее."
    },
    "from": {
     "type": "integer",
     "minimum": 1,
     "description": "Первый абзац."
    },
    "to": {
     "type": "integer",
     "minimum": 1,
     "description": "Последний абзац."
    }
   },
   "additionalProperties": false
  }
 }
]
