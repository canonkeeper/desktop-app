          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "examples": {
              "rate_limited": {
                "value": {
                  "type": "https://canonkeeper.local/problems/rate_limited",
                  "title": "Rate limited",
                  "status": 429,
                  "code": "rate_limited",
                  "requestId": "req_synthetic_01"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "AppLinkExchange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "verifier",
          "name",
          "appVersion"
        ],
        "description": "specs/2026-11-13-desk-link.md LK2.1: the code of the link and what the app links with it.",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "The code the app got on 127.0.0.1."
          },
          "verifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{43,128}$",
            "description": "The PKCE verifier of the challenge of the link."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The name of the computer, without control signs."
          },
          "appVersion": {
            "type": "string",
            "pattern": "^[0-9A-Za-z.+-]{1,32}$",
            "description": "The version of the app."
          }
        }
      },
      "AppLinkToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pass",
          "account"
        ],
        "description": "specs/2026-11-13-desk-link.md LK2.2: the pass of the app, given once, and its account.",
        "properties": {
          "pass": {
            "type": "string",
            "pattern": "^ckd_[A-Za-z0-9_-]{43}$",
            "description": "The pass of the app; the site keeps only its SHA-256."
          },
          "account": {
            "$ref": "#/components/schemas/AppAccount"
          }
        }
      },
      "AppAccount": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tier"
        ],
        "description": "specs/2026-11-13-desk-link.md LK2.2, LK3.4: the account a pass works for.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the author."
          },
          "tier": {
            "$ref": "#/components/schemas/AppTier"
          }
        }
      },
      "AppTier": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "title",
          "until"
        ],
        "description": "The tier of the site in force for the account.",
        "properties": {
          "code": {
            "type": "string",
            "description": "The code of the tier."
          },
          "title": {
            "type": "string",
            "description": "The title of the tier."
          },
          "until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "null — without term, or «Бесплатно»."
          }
        }
      },
      "AppQuota": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "resetsAt",
          "chatTurns",
          "activeTurns",
          "imports"
        ],
        "description": "specs/2026-11-13-desk-permits.md PM3.1: the limits of the model work of an app with their use, in the form of the same keys of AccountQuota. Daily counters are Moscow calendar days and reset at resetsAt.",
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "Current Moscow calendar day."
          },
          "resetsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Next 00:00 Moscow time, when daily counters reset."
          },
          "chatTurns": {
            "$ref": "#/components/schemas/QuotaCounter"
          },
          "activeTurns": {
            "$ref": "#/components/schemas/QuotaCounter"
          },
          "imports": {
            "$ref": "#/components/schemas/QuotaCounter"
          }
        }
      },
      "AppAccountState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "tier",
          "quota"
        ],
        "description": "specs/2026-11-13-desk-link.md LK3.4, specs/2026-11-13-desk-permits.md PM3.1: the account a pass works for and the units of its day.",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the author."
          },
          "tier": {
            "$ref": "#/components/schemas/AppTier"
          },
          "quota": {
            "$ref": "#/components/schemas/AppQuota"
          }
        }
      },
      "AppPermitOpen": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "description": "specs/2026-11-13-desk-permits.md PM1.1: the work the app asks a permit for and its ref.",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "chat_turn",
              "materials",
              "reading"
            ],
            "description": "chat_turn — a turn of the chat; materials — a reading of the author's materials by the model; reading — a reading of his books by the model."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$",
            "description": "An opaque value of the app naming the work; the site keeps only its SHA-256."
          }
        }
      },
      "AppPermit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "state",
          "outcome",
          "day",
          "validUntil",
          "returned"
        ],
        "description": "specs/2026-11-13-desk-permits.md PM1, PM2: a permit as the app sees it — never its ref, nor what the site saw under it.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "chat_turn",
              "materials",
              "reading"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "expired"
            ],
            "description": "open — takes work until validUntil; closed — by the app or with its unlinking; expired — its lease ended."
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "answered",
              "done",
              "canceled",
              "failed",
              "expired_unused",
              null
            ],
            "description": "null while open."
          },
          "day": {
            "type": "string",
            "format": "date",
            "description": "The Moscow day the unit of the work counts on and comes back to."
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "description": "The end of the lease: a turn — 5 minutes after its last activity, materials and reading — 24 hours after the start."
          },
          "returned": {
            "type": "boolean",
            "description": "The unit of the work came back to its day."
          }
        }
      },
      "AppPermitUnitCharge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref"
        ],
        "description": "specs/2026-11-13-desk-permits.md PM1.5: the ref of a correction of a running turn.",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._~-]+$",
            "description": "An opaque value of the app naming the correction; the site keeps only its SHA-256."
          }
        }
      },
      "AppPermitUnit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "returned"
        ],
        "description": "specs/2026-11-13-desk-permits.md PM1.5: a correction charged under a permit.",
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The Moscow day the correction counts on."
          },
          "returned": {
            "type": "boolean",
            "description": "Always false: a unit given back is charged again by the same ref."
          }
        }
      },
      "AppPermitClose": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outcome"
        ],
        "description": "specs/2026-11-13-desk-permits.md PM2.1: how the work under a permit ended, as the app names it; what the site saw under it is the site's alone.",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "answered",
              "done",
              "canceled",
              "failed"
            ],
            "description": "answered — the work got its answer; done — it ended without an answer to give; canceled — the author stopped it; failed — the model, the connection or the app failed."
          }
        }
      },
      "QuotaCounter": {
        "type": "object",
        "description": "Use of one limit.",
        "required": [
          "used",
          "limit"
        ],
        "properties": {
          "used": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457-style problem details with stable machine code and redacted request id.",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "default": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          },
          "attemptsLeft": {
            "type": "integer",
            "minimum": 0,
            "description": "auth.invalid_credentials of loginUser (specs/2026-11-10-ux3-auth.md AU3.3): how many more sign-ins the smaller window of this email takes — from this client address and from all of them; the same for an existing and an unknown email."
          },
          "lockMinutes": {
            "type": "integer",
            "minimum": 1,
            "description": "auth.invalid_credentials of loginUser: how many minutes a full window keeps the sign-in closed (429 with Retry-After)."
          },
          "materialId": {
            "type": "string",
            "format": "uuid",
            "description": "author_materials.name_taken of createAuthorMaterial and updateAuthorMaterial (specs/2026-11-10-ux8-memory-records.md MR2.3): the record of the materials that has the name."
          }
        },
        "additionalProperties": false
      },
      "ValidationIssue": {
        "type": "object",
        "required": [
          "path",
          "message",
          "code"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "JSON Pointer when applicable."
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
