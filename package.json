{
  "name": "canonkeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tmp:go": "cd backend && go",
    "dev": "vite --host 127.0.0.1",
    "mock:api": "tsx mock-server/main.ts",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "infra:up": "node scripts/local-postgres.mjs up",
    "infra:down": "node scripts/local-postgres.mjs down",
    "infra:bootstrap": "node scripts/local-postgres.mjs bootstrap",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "architecture:check": "node scripts/check-architecture.mjs",
    "backend:test": "node scripts/local-postgres.mjs test",
    "backend:verify": "npm run backend:test -- -race -count=1 ./... && (cd backend && sqlc diff && go vet ./... && go build ./... && go mod verify) && (cd translate && go vet ./... && go test -race -count=1 ./...)",
    "backend:run": "cd backend && go run ./cmd/api",
    "production:up": "node scripts/local-production.mjs up",
    "production:down": "node scripts/local-production.mjs down",
    "production:status": "node scripts/local-production.mjs status",
    "production:logs": "node scripts/local-production.mjs logs",
    "production:diagnose": "node scripts/local-production.mjs diagnose",
    "test:up": "node scripts/local-test.mjs up",
    "test:down": "node scripts/local-test.mjs down",
    "test:status": "node scripts/local-test.mjs status",
    "test:logs": "node scripts/local-test.mjs logs",
    "test:diagnose": "node scripts/local-test.mjs diagnose",
    "test:frontend:build": "node scripts/local-test-frontend.mjs build",
    "test:frontend:serve": "vite preview --host 127.0.0.1 --port 3334 --strictPort",
    "test:frontend:down": "node scripts/local-test-frontend.mjs down",
    "e2e": "playwright test --project=synthetic",
    "e2e:desktop": "playwright test --config=playwright.desktop.config.ts",
    "e2e:test": "playwright test --config=playwright.production.config.ts --project=production-canary",
    "e2e:test:bootstrap": "playwright test --config=playwright.production.config.ts --project=production-bootstrap",
    "e2e:test:model": "playwright test --config=playwright.production.config.ts --project=production-model",
    "e2e:test:large-book": "playwright test --config=playwright.production.config.ts --project=production-large-book",
    "e2e:test:saga-actor-init": "playwright test --config=playwright.production.config.ts --project=production-saga-actor-init",
    "e2e:test:saga": "playwright test --config=playwright.production.config.ts --project=production-saga",
    "e2e:production": "CK_E2E_PROFILE=production playwright test --config=playwright.production.config.ts --project=production-canary",
    "e2e:production:bootstrap": "CK_E2E_PROFILE=production playwright test --config=playwright.production.config.ts --project=production-bootstrap",
    "e2e:production:model": "CK_E2E_PROFILE=production playwright test --config=playwright.production.config.ts --project=production-model",
    "e2e:production:large-book": "CK_E2E_PROFILE=production playwright test --config=playwright.production.config.ts --project=production-large-book",
    "e2e:production:saga": "CK_E2E_PROFILE=production playwright test --config=playwright.production.config.ts --project=production-saga",
    "build": "vite build",
    "build:desktop": "node scripts/desktop-web.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.desktop.json",
    "build:desktop:backend": "node scripts/desktop-backend.mjs dist-desktop-backend/canonkeeper-backend",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude scripts/local-postgres.test.mjs --exclude scripts/local-production.test.mjs --exclude scripts/local-test-frontend.test.mjs --exclude scripts/local-test.test.mjs",
    "scripts:test": "node --test scripts/check-architecture.test.mjs scripts/api-app-contract.test.mjs scripts/check-layers.test.mjs scripts/check-artifact-manifest-fixtures.test.mjs scripts/check-canonkeeper-codex-home.test.mjs scripts/check-deletion-identity-fixtures.test.mjs scripts/check-design-system.test.mjs scripts/check-governance-emissions.test.mjs scripts/design-exec.test.mjs scripts/design-split.test.mjs scripts/check-openapi-contract.test.mjs scripts/codex-package.test.mjs scripts/database-passwords.test.mjs scripts/database-pools.test.mjs scripts/local-postgres.test.mjs scripts/local-production.test.mjs scripts/local-test-frontend.test.mjs scripts/local-test.test.mjs scripts/production-backup.test.mjs scripts/production-monitor.test.mjs scripts/release-artifact.test.mjs scripts/release-vps.test.mjs scripts/own-copy-checks.test.mjs scripts/open-source/check.test.mjs scripts/open-source/export.test.mjs scripts/check-forbidden.test.mjs scripts/desktop-backend.test.mjs scripts/desktop-app.test.mjs",
    "saga-plan:test": "node --import tsx --test e2e/production/saga-plan.test.ts",
    "verify": "npm run verify:web && npm run backend:verify",
    "vulnerabilities:check": "(cd backend && go run golang.org/x/vuln/cmd/govulncheck@v1.9.0 ./...) && npm audit --omit=dev --audit-level=moderate",
    "verify:web": "npm run api:check && npm run architecture:check && npm run contract:check && npm run scripts:test && npm run saga-plan:test && npm run test && npm run typecheck && npm run lint && npm run build && npm run codex-home:check && npm run governance:check && npm run design:check && git diff --check",
    "contract:check": "node scripts/check-openapi-contract.mjs",
    "codex-home:check": "node scripts/check-canonkeeper-codex-home.mjs codex-homes",
    "governance:check": "node scripts/check-governance-emissions.mjs && node scripts/check-deletion-identity-fixtures.mjs && node scripts/check-artifact-manifest-fixtures.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "open-source:check": "node scripts/open-source/check.mjs",
    "design:exec": "node scripts/design-exec.mjs"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "overrides": {
    "js-yaml": "4.2.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.17.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.4",
    "prosemirror-view": "1.42.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "3.0.3",
    "zod": "^4.6.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "graphology-types": "0.24.8",
    "js-yaml": "4.2.0",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
